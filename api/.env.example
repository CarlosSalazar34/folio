# OpenAI (también se acepta OPENAI_API_KEY)
OPENAI_APIKEY=
OPENAI_MODEL=

# Base de datos: SQLite en local; en Railway, su DATABASE_URL de Postgres
DATABASE_URL=sqlite:///folio.db

# S3: si S3_BUCKET está vacío se usa almacenamiento local (api/storage/)
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# URL pública de esta API (para las URLs de archivos en almacenamiento local)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Firma de las sesiones (obligatorio en producción; en local se genera api/.jwt_secret)
JWT_SECRET=
