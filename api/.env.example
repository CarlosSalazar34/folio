# OpenAI (también se acepta OPENAI_API_KEY)
OPENAI_APIKEY=
OPENAI_MODEL=

# Base de datos: SQLite en local; en Railway, su DATABASE_URL de Postgres
DATABASE_URL=sqlite:///folio.db

# Almacenamiento compatible con S3 (AWS S3 o Cloudflare R2).
# Si S3_BUCKET está vacío se usa almacenamiento local (api/storage/).
# Cloudflare R2: S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com, AWS_REGION=auto
# y las claves del token de API de R2 en AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
S3_ENDPOINT_URL=
S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# URL pública de esta API (para las URLs de archivos en almacenamiento local)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Firma de las sesiones (obligatorio en producción; en local se genera api/.jwt_secret)
JWT_SECRET=
